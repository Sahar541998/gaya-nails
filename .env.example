# Admin sign-in for /admin. Server-only. Never prefix with NEXT_PUBLIC_.
# Local Docker Compose uses these values. Change them before any public deploy.
ADMIN_USERNAME=gaya
ADMIN_PASSWORD=gaya-local
ADMIN_JWT_SECRET=local-dev-only-change-me
# ADMIN_SESSION_SECRET is still accepted as a JWT signing fallback.

# Public (browser-safe). Used by the anon Supabase client for Auth/Storage.
# Not required for the local Docker stack.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_. Never import into Client Components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local Docker (default). docker compose sets these for the app container.
# On the host, use localhost:
DATABASE_URL=postgres://gaya:gaya@localhost:5432/gaya_nails
SMS_DRIVER=docker
SMS_MOCK_URL=http://localhost:4010

# Production SMS. Required when SMS_DRIVER=twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
