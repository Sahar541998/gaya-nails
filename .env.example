# Public (browser-safe). Required when using Supabase Auth / Storage.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_. Never import into Client Components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Data access. Local Docker Postgres by default. Production: Supabase connection string.
DA_DRIVER=postgres
DATABASE_URL=postgres://gaya:gaya@localhost:5432/gaya_nails

# SMS: console (no container), mock (docker sms-mock), or twilio (production).
SMS_DRIVER=console
SMS_MOCK_URL=http://localhost:4010

# Server-only Twilio Verify. Required when SMS_DRIVER=twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
